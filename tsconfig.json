{
  // Whole-project config for editors and IDEs. `npm run typecheck` checks each area
  // with its own config (tsconfig.sim/runtime/editor/node.json), which is stricter
  // about what each area may use.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
