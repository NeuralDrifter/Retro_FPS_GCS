{
  "name": "retro-fps-gcs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:runtime && vite --port=3000",
    "dev:lan": "npm run build:runtime && vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:runtime && vite build",
    "build:runtime": "tsx scripts/build-single-html-runtime.ts",
    "build:pages": "npm run build -- --base=/Retro_FPS_GCS/",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.runtime.json && tsc -p tsconfig.editor.json && tsc -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:pages && playwright test",
    "metrics": "tsx scripts/report-metrics.ts"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
